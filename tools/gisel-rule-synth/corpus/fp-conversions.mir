---
name: train_1_0
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0
    %0:_(i32) = COPY $vgpr0
    %1:_(i32) = G_CONSTANT i32 65535
    %2:_(i32) = G_AND %0, %1
    %3:_(f32) = G_SITOFP %2
    %4:_(i32) = G_FPTOSI %3
    $vgpr0 = COPY %4
    SI_RETURN implicit $vgpr0
...
