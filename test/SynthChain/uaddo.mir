# REQUIRES: synth-chain
# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1100 -run-pass=amdgpu-prelegalizer-combiner %s -o - | FileCheck --check-prefix=OFF %s
# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1100 -run-pass=amdgpu-prelegalizer-combiner,gisynth-amdgpu-combiner %s -o - | FileCheck --check-prefix=ON %s

# The rule with two outputs that tools/gisel-rule-synth/eval/rule_chain.py
# finds in tools/gisel-rule-synth/tests/data/chain/corpus.mir (synth
# --regions): s = a + b with another user and c = s <u a are one G_UADDO,
# built alone into a scratch llc. The compare with b and the 64-bit sum are
# not in that corpus.

# OFF-LABEL: name: carry_of_sum_rhs
# OFF: %s:_(s32) = G_ADD %a, %b
# OFF-NEXT: %c:_(s1) = G_ICMP intpred(ult), %s(s32), %b
# ON-LABEL: name: carry_of_sum_rhs
# ON: %b:_(s32) = COPY $vgpr1
# ON-NEXT: %s:_(s32), %c:_(s1) = G_UADDO %b, %a
# ON-NEXT: %z:_(s32) = G_ZEXT %c(s1)
# ON-NEXT: $vgpr0 = COPY %s(s32)
# ON-NEXT: $vgpr1 = COPY %z(s32)
---
name: carry_of_sum_rhs
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
    %a:_(s32) = COPY $vgpr0
    %b:_(s32) = COPY $vgpr1
    %s:_(s32) = G_ADD %a, %b
    %c:_(s1) = G_ICMP intpred(ult), %s, %b
    %z:_(s32) = G_ZEXT %c
    $vgpr0 = COPY %s
    $vgpr1 = COPY %z
    SI_RETURN implicit $vgpr0, implicit $vgpr1
...

# OFF-LABEL: name: carry_of_sum_s64
# OFF: %s:_(s64) = G_ADD %a, %b
# ON-LABEL: name: carry_of_sum_s64
# ON: %b:_(s64) = COPY $vgpr2_vgpr3
# ON-NEXT: %s:_(s64), %c:_(s1) = G_UADDO %a, %b
# ON-NEXT: %z:_(s32) = G_ZEXT %c(s1)
---
name: carry_of_sum_s64
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0_vgpr1, $vgpr2_vgpr3
    %a:_(s64) = COPY $vgpr0_vgpr1
    %b:_(s64) = COPY $vgpr2_vgpr3
    %s:_(s64) = G_ADD %a, %b
    %c:_(s1) = G_ICMP intpred(ult), %s, %a
    %z:_(s32) = G_ZEXT %c
    $vgpr0_vgpr1 = COPY %s
    $vgpr2 = COPY %z
    SI_RETURN implicit $vgpr0_vgpr1, implicit $vgpr2
...

# ON-LABEL: name: ugt_no_fold
# ON: %s:_(s32) = G_ADD %a, %b
# ON-NEXT: %c:_(s1) = G_ICMP intpred(ugt), %s(s32), %a
# s >u a is not the carry.
---
name: ugt_no_fold
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
    %a:_(s32) = COPY $vgpr0
    %b:_(s32) = COPY $vgpr1
    %s:_(s32) = G_ADD %a, %b
    %c:_(s1) = G_ICMP intpred(ugt), %s, %a
    %z:_(s32) = G_ZEXT %c
    $vgpr0 = COPY %s
    $vgpr1 = COPY %z
    SI_RETURN implicit $vgpr0, implicit $vgpr1
...

# ON-LABEL: name: single_use_no_fold
# ON: %s:_(s32) = G_ADD %a, %b
# ON-NEXT: %c:_(s1) = G_ICMP intpred(ult), %s(s32), %a
# The sum has no other user: the rule of two outputs does not apply (the
# scratch build has no rule of the carry alone).
---
name: single_use_no_fold
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
    %a:_(s32) = COPY $vgpr0
    %b:_(s32) = COPY $vgpr1
    %s:_(s32) = G_ADD %a, %b
    %c:_(s1) = G_ICMP intpred(ult), %s, %a
    %z:_(s32) = G_ZEXT %c
    $vgpr0 = COPY %z
    SI_RETURN implicit $vgpr0
...
