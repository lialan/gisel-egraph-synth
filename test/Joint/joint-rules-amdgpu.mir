# x*x and (x-y)*(x+y): the square stays (its flags are dropped, a new
# instruction reads it), y*y is new, the product is replaced.
---
name: dsq
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1

    ; CHECK-LABEL: name: dsq
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(i32) = COPY $vgpr0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(i32) = COPY $vgpr1
    ; CHECK-NEXT: [[MUL:%[0-9]+]]:_(i32) = G_MUL [[COPY]], [[COPY]]
    ; CHECK-NEXT: [[MUL1:%[0-9]+]]:_(i32) = G_MUL [[COPY1]], [[COPY1]]
    ; CHECK-NEXT: [[SUB:%[0-9]+]]:_(i32) = G_SUB [[MUL]], [[MUL1]]
    ; CHECK-NEXT: $vgpr0 = COPY [[MUL]](i32)
    ; CHECK-NEXT: $vgpr1 = COPY [[SUB]](i32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0, implicit $vgpr1
    %0:_(i32) = COPY $vgpr0
    %1:_(i32) = COPY $vgpr1
    %2:_(i32) = G_MUL %0, %0
    %3:_(i32) = G_SUB %0, %1
    %4:_(i32) = G_ADD %1, %0
    %5:_(i32) = G_MUL %3, %4
    $vgpr0 = COPY %2(i32)
    $vgpr1 = COPY %5(i32)
    SI_RETURN implicit $vgpr0, implicit $vgpr1
...

# Commuted operands.
---
name: dsq_commuted
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1

    ; CHECK-LABEL: name: dsq_commuted
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(i32) = COPY $vgpr0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(i32) = COPY $vgpr1
    ; CHECK-NEXT: [[MUL:%[0-9]+]]:_(i32) = G_MUL [[COPY]], [[COPY]]
    ; CHECK-NEXT: [[MUL1:%[0-9]+]]:_(i32) = G_MUL [[COPY1]], [[COPY1]]
    ; CHECK-NEXT: [[SUB:%[0-9]+]]:_(i32) = G_SUB [[MUL]], [[MUL1]]
    ; CHECK-NEXT: $vgpr0 = COPY [[MUL]](i32)
    ; CHECK-NEXT: $vgpr1 = COPY [[SUB]](i32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0, implicit $vgpr1
    %0:_(i32) = COPY $vgpr0
    %1:_(i32) = COPY $vgpr1
    %2:_(i32) = G_MUL %0, %0
    %3:_(i32) = G_SUB %0, %1
    %4:_(i32) = G_ADD %0, %1
    %5:_(i32) = G_MUL %4, %3
    $vgpr0 = COPY %2(i32)
    $vgpr1 = COPY %5(i32)
    SI_RETURN implicit $vgpr0, implicit $vgpr1
...

# The square has nsw: it loses it.
---
name: dsq_square_nsw
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1

    ; CHECK-LABEL: name: dsq_square_nsw
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(i32) = COPY $vgpr0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(i32) = COPY $vgpr1
    ; CHECK-NEXT: [[MUL:%[0-9]+]]:_(i32) = G_MUL [[COPY]], [[COPY]]
    ; CHECK-NEXT: [[MUL1:%[0-9]+]]:_(i32) = G_MUL [[COPY1]], [[COPY1]]
    ; CHECK-NEXT: [[SUB:%[0-9]+]]:_(i32) = G_SUB [[MUL]], [[MUL1]]
    ; CHECK-NEXT: $vgpr0 = COPY [[MUL]](i32)
    ; CHECK-NEXT: $vgpr1 = COPY [[SUB]](i32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0, implicit $vgpr1
    %0:_(i32) = COPY $vgpr0
    %1:_(i32) = COPY $vgpr1
    %2:_(i32) = nsw G_MUL %0, %0
    %3:_(i32) = G_SUB %0, %1
    %4:_(i32) = G_ADD %1, %0
    %5:_(i32) = G_MUL %3, %4
    $vgpr0 = COPY %2(i32)
    $vgpr1 = COPY %5(i32)
    SI_RETURN implicit $vgpr0, implicit $vgpr1
...

# Flags of an instruction that dies do not matter.
---
name: dsq_root_nsw
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1

    ; CHECK-LABEL: name: dsq_root_nsw
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(i32) = COPY $vgpr0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(i32) = COPY $vgpr1
    ; CHECK-NEXT: [[MUL:%[0-9]+]]:_(i32) = G_MUL [[COPY]], [[COPY]]
    ; CHECK-NEXT: [[MUL1:%[0-9]+]]:_(i32) = G_MUL [[COPY1]], [[COPY1]]
    ; CHECK-NEXT: [[SUB:%[0-9]+]]:_(i32) = G_SUB [[MUL]], [[MUL1]]
    ; CHECK-NEXT: $vgpr0 = COPY [[MUL]](i32)
    ; CHECK-NEXT: $vgpr1 = COPY [[SUB]](i32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0, implicit $vgpr1
    %0:_(i32) = COPY $vgpr0
    %1:_(i32) = COPY $vgpr1
    %2:_(i32) = G_MUL %0, %0
    %3:_(i32) = G_SUB %0, %1
    %4:_(i32) = G_ADD %1, %0
    %5:_(i32) = nsw G_MUL %3, %4
    $vgpr0 = COPY %2(i32)
    $vgpr1 = COPY %5(i32)
    SI_RETURN implicit $vgpr0, implicit $vgpr1
...

# The arguments are not noundef: defined(x), defined(y) fail.
---
