# x - y has another user: it would not die.
---
name: dsq_extra_user
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1

    ; CHECK-LABEL: name: dsq_extra_user
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(i32) = COPY $vgpr0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(i32) = COPY $vgpr1
    ; CHECK-NEXT: [[MUL:%[0-9]+]]:_(i32) = G_MUL [[COPY]], [[COPY]]
    ; CHECK-NEXT: [[SUB:%[0-9]+]]:_(i32) = G_SUB [[COPY]], [[COPY1]]
    ; CHECK-NEXT: [[ADD:%[0-9]+]]:_(i32) = G_ADD [[COPY1]], [[COPY]]
    ; CHECK-NEXT: [[MUL1:%[0-9]+]]:_(i32) = G_MUL [[SUB]], [[ADD]]
    ; CHECK-NEXT: [[XOR:%[0-9]+]]:_(i32) = G_XOR [[MUL1]], [[SUB]]
    ; CHECK-NEXT: $vgpr0 = COPY [[MUL]](i32)
    ; CHECK-NEXT: $vgpr1 = COPY [[XOR]](i32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0, implicit $vgpr1
    %0:_(i32) = COPY $vgpr0
    %1:_(i32) = COPY $vgpr1
    %2:_(i32) = G_MUL %0, %0
    %3:_(i32) = G_SUB %0, %1
    %4:_(i32) = G_ADD %1, %0
    %5:_(i32) = G_MUL %3, %4
    %6:_(i32) = G_XOR %5, %3
    $vgpr0 = COPY %2(i32)
    $vgpr1 = COPY %6(i32)
    SI_RETURN implicit $vgpr0, implicit $vgpr1
...

# The square is after the product, before its users: the new
# instructions are placed after the square.
---
name: dsq_square_after_root
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1

    ; CHECK-LABEL: name: dsq_square_after_root
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(i32) = COPY $vgpr0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(i32) = COPY $vgpr1
    ; CHECK-NEXT: [[MUL:%[0-9]+]]:_(i32) = G_MUL [[COPY]], [[COPY]]
    ; CHECK-NEXT: [[MUL1:%[0-9]+]]:_(i32) = G_MUL [[COPY1]], [[COPY1]]
    ; CHECK-NEXT: [[SUB:%[0-9]+]]:_(i32) = G_SUB [[MUL]], [[MUL1]]
    ; CHECK-NEXT: $vgpr0 = COPY [[MUL]](i32)
    ; CHECK-NEXT: $vgpr1 = COPY [[SUB]](i32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0, implicit $vgpr1
    %0:_(i32) = COPY $vgpr0
    %1:_(i32) = COPY $vgpr1
    %3:_(i32) = G_SUB %0, %1
    %4:_(i32) = G_ADD %1, %0
    %5:_(i32) = G_MUL %3, %4
    %2:_(i32) = G_MUL %0, %0
    $vgpr0 = COPY %2(i32)
    $vgpr1 = COPY %5(i32)
    SI_RETURN implicit $vgpr0, implicit $vgpr1
...

# The square is after a user of the product: no position follows the
# square and dominates that user.
---
name: dsq_square_after_use
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1

    ; CHECK-LABEL: name: dsq_square_after_use
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(i32) = COPY $vgpr0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(i32) = COPY $vgpr1
    ; CHECK-NEXT: [[SUB:%[0-9]+]]:_(i32) = G_SUB [[COPY]], [[COPY1]]
    ; CHECK-NEXT: [[ADD:%[0-9]+]]:_(i32) = G_ADD [[COPY1]], [[COPY]]
    ; CHECK-NEXT: [[MUL:%[0-9]+]]:_(i32) = G_MUL [[SUB]], [[ADD]]
    ; CHECK-NEXT: $vgpr1 = COPY [[MUL]](i32)
    ; CHECK-NEXT: [[MUL1:%[0-9]+]]:_(i32) = G_MUL [[COPY]], [[COPY]]
    ; CHECK-NEXT: $vgpr0 = COPY [[MUL1]](i32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0, implicit $vgpr1
    %0:_(i32) = COPY $vgpr0
    %1:_(i32) = COPY $vgpr1
    %3:_(i32) = G_SUB %0, %1
    %4:_(i32) = G_ADD %1, %0
    %5:_(i32) = G_MUL %3, %4
    $vgpr1 = COPY %5(i32)
    %2:_(i32) = G_MUL %0, %0
    $vgpr0 = COPY %2(i32)
    SI_RETURN implicit $vgpr0, implicit $vgpr1
...

# x*(y+1), x*(y-1) after opt -O2: one new x*y for both outputs.
---
name: helper
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1

    ; CHECK-LABEL: name: helper
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(i32) = COPY $vgpr0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(i32) = COPY $vgpr1
    ; CHECK-NEXT: [[MUL:%[0-9]+]]:_(i32) = G_MUL [[COPY1]], [[COPY]]
    ; CHECK-NEXT: [[ADD:%[0-9]+]]:_(i32) = G_ADD [[COPY]], [[MUL]]
    ; CHECK-NEXT: [[SUB:%[0-9]+]]:_(i32) = G_SUB [[MUL]], [[COPY]]
    ; CHECK-NEXT: $vgpr0 = COPY [[ADD]](i32)
    ; CHECK-NEXT: $vgpr1 = COPY [[SUB]](i32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0, implicit $vgpr1
    %0:_(i32) = COPY $vgpr0
    %1:_(i32) = COPY $vgpr1
    %2:_(i32) = G_CONSTANT i32 1
    %3:_(i32) = G_ADD %1, %2
    %4:_(i32) = G_MUL %3, %0
    %5:_(i32) = G_SHL %0, %2(i32)
    %6:_(i32) = G_SUB %4, %5
    $vgpr0 = COPY %4(i32)
    $vgpr1 = COPY %6(i32)
    SI_RETURN implicit $vgpr0, implicit $vgpr1
...

# The constant is 2, not 1: not the rule.
---
name: helper_two
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1

    ; CHECK-LABEL: name: helper_two
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(i32) = COPY $vgpr0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(i32) = COPY $vgpr1
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i32) = G_CONSTANT i32 2
    ; CHECK-NEXT: [[ADD:%[0-9]+]]:_(i32) = G_ADD [[COPY1]], [[C]]
    ; CHECK-NEXT: [[MUL:%[0-9]+]]:_(i32) = G_MUL [[ADD]], [[COPY]]
    ; CHECK-NEXT: [[SHL:%[0-9]+]]:_(i32) = G_SHL [[COPY]], [[C]](i32)
    ; CHECK-NEXT: [[SUB:%[0-9]+]]:_(i32) = G_SUB [[MUL]], [[SHL]]
    ; CHECK-NEXT: $vgpr0 = COPY [[MUL]](i32)
    ; CHECK-NEXT: $vgpr1 = COPY [[SUB]](i32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0, implicit $vgpr1
    %0:_(i32) = COPY $vgpr0
    %1:_(i32) = COPY $vgpr1
    %2:_(i32) = G_CONSTANT i32 2
    %3:_(i32) = G_ADD %1, %2
    %4:_(i32) = G_MUL %3, %0
    %5:_(i32) = G_SHL %0, %2(i32)
    %6:_(i32) = G_SUB %4, %5
    $vgpr0 = COPY %4(i32)
    $vgpr1 = COPY %6(i32)
    SI_RETURN implicit $vgpr0, implicit $vgpr1
...
