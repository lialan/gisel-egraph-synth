# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu11.00-amd-amdhsa -mcpu=gfx1100 -run-pass=gisynth-joint-combiner %s -o - | FileCheck %s

# Joint rules of equal generic cost that the measured selection kept
# (eval/joint_measure.py; docs/Joint-Regions-Validation.md): each one is
# no cheaper in the generic cost model, and the target code is smaller.
# A rule of equal cost only replaces instructions that the combiner did not
# create (RuleDesc::OriginalOnly).

--- |
  define i32 @sel_inc(i32 %x, i32 %y) {
    ret i32 poison
  }
  define i16 @sel_inc_i16(i32 %x, i32 %y) {
    ret i16 poison
  }
  define i32 @sel_inc_twice(i32 %x, i32 %y) {
    ret i32 poison
  }
  define i32 @sel_inc_swapped(i32 %x, i32 %y) {
    ret i32 poison
  }
  define i32 @sel_add_two(i32 %x, i32 %y) {
    ret i32 poison
  }
  define i32 @sel_add_const(i32 %x, i32 %y) {
    ret i32 poison
  }
  define i32 @dec_sub(i32 %x, i32 %z) {
    ret i32 poison
  }
  define { i64, i64 } @and_sub(i64 noundef %x) {
    ret { i64, i64 } poison
  }
  define { i64, i64 } @and_sub_not_noundef(i64 %x) {
    ret { i64, i64 } poison
  }
...

# select(c, y + 1, y) -> y + zext(c): the quotient correction of an integer
# division; gfx1100 then adds the corrections with v_add3_u32.
---
name: sel_inc
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1

    ; CHECK-LABEL: name: sel_inc
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(i32) = COPY $vgpr0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(i32) = COPY $vgpr1
    ; CHECK-NEXT: [[ICMP:%[0-9]+]]:_(i1) = G_ICMP intpred(uge), [[COPY]](i32), [[COPY1]]
    ; CHECK-NEXT: [[ZEXT:%[0-9]+]]:_(i32) = G_ZEXT [[ICMP]](i1)
    ; CHECK-NEXT: [[ADD:%[0-9]+]]:_(i32) = G_ADD [[COPY1]], [[ZEXT]]
    ; CHECK-NEXT: $vgpr0 = COPY [[ADD]](i32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    %0:_(i32) = COPY $vgpr0
    %1:_(i32) = COPY $vgpr1
    %2:_(i1) = G_ICMP intpred(uge), %0(i32), %1
    %3:_(i32) = G_CONSTANT i32 1
    %4:_(i32) = G_ADD %1, %3
    %5:_(i32) = G_SELECT %2(i1), %4, %1
    $vgpr0 = COPY %5(i32)
    SI_RETURN implicit $vgpr0
...

# The same at 16 bits (a proved width map of the rule).
---
name: sel_inc_i16
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1

    ; CHECK-LABEL: name: sel_inc_i16
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(i32) = COPY $vgpr0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(i32) = COPY $vgpr1
    ; CHECK-NEXT: [[ICMP:%[0-9]+]]:_(i1) = G_ICMP intpred(uge), [[COPY]](i32), [[COPY1]]
    ; CHECK-NEXT: [[TRUNC:%[0-9]+]]:_(i16) = G_TRUNC [[COPY1]](i32)
    ; CHECK-NEXT: [[ZEXT:%[0-9]+]]:_(i16) = G_ZEXT [[ICMP]](i1)
    ; CHECK-NEXT: [[ADD:%[0-9]+]]:_(i16) = G_ADD [[TRUNC]], [[ZEXT]]
    ; CHECK-NEXT: [[ANYEXT:%[0-9]+]]:_(i32) = G_ANYEXT [[ADD]](i16)
    ; CHECK-NEXT: $vgpr0 = COPY [[ANYEXT]](i32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    %0:_(i32) = COPY $vgpr0
    %1:_(i32) = COPY $vgpr1
    %2:_(i1) = G_ICMP intpred(uge), %0(i32), %1
    %3:_(i16) = G_TRUNC %1(i32)
    %4:_(i16) = G_CONSTANT i16 1
    %5:_(i16) = G_ADD %3, %4
    %6:_(i16) = G_SELECT %2(i1), %5, %3
    %7:_(i32) = G_ANYEXT %6(i16)
    $vgpr0 = COPY %7(i32)
    SI_RETURN implicit $vgpr0
...

# Two corrections in a row, as in the expansion of a division: each one is
# an instance in the original code.
---
name: sel_inc_twice
tracksRegLiveness: true
body: |
