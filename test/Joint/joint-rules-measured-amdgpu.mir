# select(c, y + C, y) -> y + select(c, C, 0) for the constant of its
# training instance (proved at 32 bits only).
---
name: sel_add_const
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1

    ; CHECK-LABEL: name: sel_add_const
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(i32) = COPY $vgpr0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(i32) = COPY $vgpr1
    ; CHECK-NEXT: [[ICMP:%[0-9]+]]:_(i1) = G_ICMP intpred(uge), [[COPY]](i32), [[COPY1]]
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i32) = G_CONSTANT i32 -23423
    ; CHECK-NEXT: [[C1:%[0-9]+]]:_(i32) = G_CONSTANT i32 0
    ; CHECK-NEXT: [[SELECT:%[0-9]+]]:_(i32) = G_SELECT [[ICMP]](i1), [[C]], [[C1]]
    ; CHECK-NEXT: [[ADD:%[0-9]+]]:_(i32) = G_ADD [[COPY1]], [[SELECT]]
    ; CHECK-NEXT: $vgpr0 = COPY [[ADD]](i32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    %0:_(i32) = COPY $vgpr0
    %1:_(i32) = COPY $vgpr1
    %2:_(i1) = G_ICMP intpred(uge), %0(i32), %1
    %3:_(i32) = G_CONSTANT i32 -23423
    %4:_(i32) = G_ADD %1, %3
    %5:_(i32) = G_SELECT %2(i1), %4, %1
    $vgpr0 = COPY %5(i32)
    SI_RETURN implicit $vgpr0
...

# (x - 1) - z -> x + (-1 - z).
---
name: dec_sub
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1

    ; CHECK-LABEL: name: dec_sub
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(i32) = COPY $vgpr0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(i32) = COPY $vgpr1
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i32) = G_CONSTANT i32 -1
    ; CHECK-NEXT: [[SUB:%[0-9]+]]:_(i32) = G_SUB [[C]], [[COPY1]]
    ; CHECK-NEXT: [[ADD:%[0-9]+]]:_(i32) = G_ADD [[COPY]], [[SUB]]
    ; CHECK-NEXT: $vgpr0 = COPY [[ADD]](i32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    %0:_(i32) = COPY $vgpr0
    %1:_(i32) = COPY $vgpr1
    %2:_(i32) = G_CONSTANT i32 -1
    %3:_(i32) = G_ADD %0, %2
    %4:_(i32) = G_SUB %3, %1
    $vgpr0 = COPY %4(i32)
    SI_RETURN implicit $vgpr0
...

# Two outputs: m = x & 15 stays, x - m -> x ^ m. x is read twice by the
# new DAG, so it must be defined (noundef arguments).
---
name: and_sub
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1

    ; CHECK-LABEL: name: and_sub
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(i32) = COPY $vgpr0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(i32) = COPY $vgpr1
    ; CHECK-NEXT: [[MV:%[0-9]+]]:_(i64) = G_MERGE_VALUES [[COPY]](i32), [[COPY1]](i32)
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i64) = G_CONSTANT i64 15
    ; CHECK-NEXT: [[AND:%[0-9]+]]:_(i64) = G_AND [[MV]], [[C]]
    ; CHECK-NEXT: [[XOR:%[0-9]+]]:_(i64) = G_XOR [[MV]], [[AND]]
    ; CHECK-NEXT: [[UV:%[0-9]+]]:_(i32), [[UV1:%[0-9]+]]:_(i32) = G_UNMERGE_VALUES [[AND]](i64)
    ; CHECK-NEXT: [[UV2:%[0-9]+]]:_(i32), [[UV3:%[0-9]+]]:_(i32) = G_UNMERGE_VALUES [[XOR]](i64)
    ; CHECK-NEXT: $vgpr0 = COPY [[UV]](i32)
    ; CHECK-NEXT: $vgpr1 = COPY [[UV1]](i32)
    ; CHECK-NEXT: $vgpr2 = COPY [[UV2]](i32)
    ; CHECK-NEXT: $vgpr3 = COPY [[UV3]](i32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0, implicit $vgpr1, implicit $vgpr2, implicit $vgpr3
    %0:_(i32) = COPY $vgpr0
    %1:_(i32) = COPY $vgpr1
    %2:_(i64) = G_MERGE_VALUES %0(i32), %1(i32)
    %3:_(i64) = G_CONSTANT i64 15
    %4:_(i64) = G_AND %2, %3
    %5:_(i64) = G_SUB %2, %4
    %6:_(i32), %7:_(i32) = G_UNMERGE_VALUES %4(i64)
    %8:_(i32), %9:_(i32) = G_UNMERGE_VALUES %5(i64)
    $vgpr0 = COPY %6(i32)
    $vgpr1 = COPY %7(i32)
    $vgpr2 = COPY %8(i32)
    $vgpr3 = COPY %9(i32)
    SI_RETURN implicit $vgpr0, implicit $vgpr1, implicit $vgpr2, implicit $vgpr3
...

