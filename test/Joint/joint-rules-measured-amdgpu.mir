    ; CHECK-NEXT: [[ZEXT:%[0-9]+]]:_(i32) = G_ZEXT [[ICMP]](i1)
    ; CHECK-NEXT: [[ADD:%[0-9]+]]:_(i32) = G_ADD [[COPY1]], [[ZEXT]]
    ; CHECK-NEXT: [[ICMP1:%[0-9]+]]:_(i1) = G_ICMP intpred(ugt), [[COPY]](i32), [[ADD]]
    ; CHECK-NEXT: [[ZEXT1:%[0-9]+]]:_(i32) = G_ZEXT [[ICMP1]](i1)
    ; CHECK-NEXT: [[ADD1:%[0-9]+]]:_(i32) = G_ADD [[ADD]], [[ZEXT1]]
    ; CHECK-NEXT: $vgpr0 = COPY [[ADD1]](i32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    %0:_(i32) = COPY $vgpr0
    %1:_(i32) = COPY $vgpr1
    %2:_(i1) = G_ICMP intpred(uge), %0(i32), %1
    %3:_(i32) = G_CONSTANT i32 1
    %4:_(i32) = G_ADD %1, %3
    %5:_(i32) = G_SELECT %2(i1), %4, %1
    %6:_(i1) = G_ICMP intpred(ugt), %0(i32), %5
    %7:_(i32) = G_ADD %5, %3
    %8:_(i32) = G_SELECT %6(i1), %7, %5
    $vgpr0 = COPY %8(i32)
    SI_RETURN implicit $vgpr0
...

