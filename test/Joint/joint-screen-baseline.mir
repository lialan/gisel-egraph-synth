# RUN: llc -mtriple=amdgpu11.00-amd-amdhsa -mcpu=gfx1100 -run-pass=gisynth-joint-combiner -verify-machineinstrs -gisel-synth-joint-screen %s -o - | FileCheck %s --check-prefix=READONLY
# RUN: llc -mtriple=amdgpu11.00-amd-amdhsa -mcpu=gfx1100 -run-pass=gisynth-joint-combiner -verify-machineinstrs -gisel-synth-joint-screen -gisel-synth-joint-screen-apply=joint_48f67f7f94 %s -o - | FileCheck %s --check-prefix=BASE

# Only the allowed baseline can rewrite during screening. Other candidates
# must remain read-only even though their generated matchers are enabled.
--- |
  define i32 @baseline(i32 %x, i32 %y) { ret i32 poison }
  define i32 @candidate(i32 %x, i32 %z) { ret i32 poison }
...
---
name: baseline
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
    ; READONLY-LABEL: name: baseline
    ; READONLY: G_SELECT
    ; BASE-LABEL: name: baseline
    ; BASE: [[EXT:%[0-9]+]]:_(i32) = G_ZEXT
    ; BASE-NEXT: {{%[0-9]+}}:_(i32) = G_ADD {{%[0-9]+}}, [[EXT]]
    ; BASE-NOT: G_SELECT
    ; BASE: SI_RETURN
    %0:_(i32) = COPY $vgpr0
    %1:_(i32) = COPY $vgpr1
    %2:_(i1) = G_ICMP intpred(uge), %0(i32), %1
    %3:_(i32) = G_CONSTANT i32 1
    %4:_(i32) = G_ADD %1, %3
    %5:_(i32) = G_SELECT %2(i1), %4, %1
    $vgpr0 = COPY %5(i32)
    SI_RETURN implicit $vgpr0
...
---
name: candidate
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
    ; READONLY-LABEL: name: candidate
    ; READONLY: G_ADD
    ; READONLY-NEXT: {{%[0-9]+}}:_(i32) = G_SUB
    ; BASE-LABEL: name: candidate
    ; BASE: G_ADD
    ; BASE-NEXT: {{%[0-9]+}}:_(i32) = G_SUB
    %0:_(i32) = COPY $vgpr0
    %1:_(i32) = COPY $vgpr1
    %2:_(i32) = G_CONSTANT i32 -1
    %3:_(i32) = G_ADD %0, %2
    %4:_(i32) = G_SUB %3, %1
    $vgpr0 = COPY %4(i32)
    SI_RETURN implicit $vgpr0
...
