# RUN: llc -mtriple=amdgpu8.03-amd-amdhsa -run-pass=gisel-egraph-combiner -gisel-egraph-report %s -o /dev/null 2>&1 | FileCheck %s --check-prefix=GFX8
# RUN: llc -mtriple=amdgpu9.00-amd-amdhsa -run-pass=gisel-egraph-combiner -gisel-egraph-report %s -o /dev/null 2>&1 | FileCheck %s --check-prefix=GFX9
# RUN: llc -mtriple=amdgpu11.00-amd-amdhsa -run-pass=gisel-egraph-combiner -gisel-egraph-report %s -o /dev/null 2>&1 | FileCheck %s --check-prefix=GFX11
# RUN: llc -mtriple=amdgpu11.00-amd-amdhsa -run-pass=gisel-egraph-combiner -gisel-egraph-report -gisel-egraph-features=no-patterns %s -o /dev/null 2>&1 | FileCheck %s --check-prefix=FLAT
# RUN: llc -mtriple=amdgpu11.00-amd-amdhsa -run-pass=gisel-egraph-combiner -gisel-egraph-report -gisel-egraph-mul-cost=1 %s -o /dev/null 2>&1 | FileCheck %s --check-prefix=MUL1
# RUN: llc -mtriple=amdgpu11.00-amd-amdhsa -run-pass=gisel-egraph-combiner -gisel-egraph-report -gisel-egraph-mul-cost=1 -gisel-egraph-features=no-patterns %s -o /dev/null 2>&1 | FileCheck %s --check-prefix=MUL1-FLAT
# RUN: llc -mtriple=amdgpu11.00-amd-amdhsa -run-pass=gisel-egraph-combiner -gisel-egraph-mode=rewrite %s -o - | FileCheck %s --check-prefix=MIR

# The cost of the three-operand VALU instructions that the AMDGPU instruction
# selector forms from two generic operations (V_ADD3_U32 and the rest of the
# ThreeOp family), with the bank of each value predicted from the uniformity
# analysis. The original region and the candidate are costed by the same
# function, so a fusion that the selector already makes is not a gain. The
# instructions that the selector makes are in egraph-combiner-add3.ll.

# GFX8: add_constants: target-costs: amdgpu gfx803: constant-bus=1 vop3-literal=no three-op=none bank-source=uniformity-analysis position=pre-legalizer patterns=on banks=on dag=on
# GFX8: add_constants: %bb.0: {{.*}} cost=3->2 profitable (equivalence) shadow bytes=12->8 depth=2->2 covers=0->0 uniform-roots=0
# GFX8: add_shared_inner: %bb.0: {{.*}} cost=3->3 not-profitable {{.*}} covers=0->0 uniform-roots=0
# GFX8: add_uniform: %bb.0: {{.*}} cost=2->2 not-profitable {{.*}} covers=0->0 uniform-roots=1
# GFX8: add_two_sgprs: %bb.0: {{.*}} cost=2->2 not-profitable {{.*}} covers=0->0
# GFX8: add_reassociate_banks: %bb.0: {{.*}} cost=4->4 not-profitable {{.*}} covers=0->0
# GFX8: shl_add: %bb.0: {{.*}} cost=2->2 not-profitable {{.*}} covers=0->0
# GFX8: add_lshl_uniform_inner: %bb.0: {{.*}} cost=2->2 not-profitable {{.*}} covers=0->0

# GFX9: add_constants: target-costs: amdgpu gfx900: constant-bus=1 vop3-literal=no three-op=V_MAD_U64_U32_e64,V_XAD_U32_e64,V_OR3_B32_e64,V_AND_OR_B32_e64,V_LSHL_OR_B32_e64,V_ADD3_U32_e64,V_ADD_LSHL_U32_e64,V_LSHL_ADD_U32_e64 bank-source=uniformity-analysis position=pre-legalizer
# GFX9: add_constants: %bb.0: {{.*}} cost=2->1 profitable (equivalence) shadow bytes=12->8 depth=2->1 covers=1->1 uniform-roots=0
# GFX9-NEXT: root {{%[0-9]+}} = (G_ADD 16 (G_ADD %0 %1))
# GFX9: covers: original=[V_ADD3_U32_e64] new=[V_ADD3_U32_e64]
# GFX9: add_shared_inner: %bb.0: {{.*}} cost=3->3 not-profitable {{.*}} covers=0->0
# GFX9: add_uniform: %bb.0: {{.*}} cost=2->2 not-profitable {{.*}} covers=0->0 uniform-roots=1
# GFX9: add_two_sgprs: %bb.0: {{.*}} cost=2->2 not-profitable bytes=12->12 {{.*}} covers=1->1
# GFX9: add_reassociate_banks: %bb.0: {{.*}} cost=4->4 not-profitable {{.*}} covers=1->1
# GFX9-NEXT: covers: original=[V_AND_OR_B32_e64] new=[V_AND_OR_B32_e64]
# GFX9: shl_add: %bb.0: {{.*}} cost=1->1 not-profitable {{.*}} covers=1->1
# GFX9-NEXT: covers: original=[V_LSHL_ADD_U32_e64] new=[V_LSHL_ADD_U32_e64]
# GFX9: add_lshl_uniform_inner: %bb.0: {{.*}} cost=2->2 not-profitable {{.*}} covers=0->0

# GFX11: add_constants: target-costs: amdgpu gfx1100: constant-bus=2 vop3-literal=yes three-op=V_XOR3_B32_e64,V_XAD_U32_e64,V_OR3_B32_e64,V_AND_OR_B32_e64,V_LSHL_OR_B32_e64,V_ADD3_U32_e64,V_ADD_LSHL_U32_e64,V_LSHL_ADD_U32_e64 bank-source=uniformity-analysis position=pre-legalizer
# GFX11: add_constants: %bb.0: {{.*}} cost=2->1 profitable (equivalence) shadow {{.*}} covers=1->1
# GFX11: add_shared_inner: %bb.0: {{.*}} cost=3->3 not-profitable {{.*}} covers=0->0
# GFX11: add_uniform: %bb.0: {{.*}} cost=2->2 not-profitable {{.*}} covers=0->0 uniform-roots=1
# GFX11: add_two_sgprs: %bb.0: {{.*}} cost=1->1 not-profitable bytes=8->8 {{.*}} covers=1->1
# GFX11: add_reassociate_banks: %bb.0: {{.*}} cost=3->2 profitable (equivalence) shadow {{.*}} covers=1->2 uniform-roots=0 dag-improved=1
# GFX11-NEXT: root {{%[0-9]+}} = (G_OR (G_AND %2 255) (G_ADD %1 (G_ADD %2 %0)))
# GFX11: covers: original=[V_AND_OR_B32_e64] new=[V_AND_OR_B32_e64,V_ADD3_U32_e64]
# GFX11: shl_add: %bb.0: {{.*}} cost=1->1 not-profitable {{.*}} covers=1->1
# GFX11: add_lshl_uniform_inner: %bb.0: {{.*}} cost=1->1 not-profitable {{.*}} covers=1->1
# GFX11-NEXT: covers: original=[V_ADD_LSHL_U32_e64] new=[V_ADD_LSHL_U32_e64]

# FLAT: add_constants: target-costs: {{.*}} patterns=off banks=on dag=on
# FLAT: add_constants: %bb.0: {{.*}} cost=3->2 profitable
# FLAT: add_reassociate_banks: %bb.0: {{.*}} cost=4->4 not-profitable
# FLAT: shl_add: %bb.0: {{.*}} cost=2->2 not-profitable

# On a tie of the cost extraction keeps the instructions of the region
# (CostModel::isPreferred): with a multiplication as cheap as a shift, a * 9
# costs as much as the v_lshl_add_u32, so the candidate is the original.
# MUL1: shl_add: %bb.0: {{.*}} cost=1->1 not-profitable {{.*}} covers=1->1 {{.*}} kept=2/2
# MUL1-FLAT: shl_add: %bb.0: {{.*}} cost=2->1 profitable (refinement) shadow
# MUL1-FLAT-NEXT: root {{%[0-9]+}} = (G_MUL %0 9)

# MIR-LABEL: name: add_constants
# MIR: [[SUM:%[0-9]+]]:_(s32) = G_ADD %a, %b
# MIR-NEXT: [[C16:%[0-9]+]]:_(s32) = G_CONSTANT i32 16
# MIR-NEXT: [[R:%[0-9]+]]:_(s32) = G_ADD [[SUM]], [[C16]]
# MIR-NEXT: $vgpr0 = COPY [[R]](s32)
# MIR-LABEL: name: add_shared_inner
# MIR: %t:_(s32) = G_ADD %a, %b
# MIR-NEXT: %r:_(s32) = G_ADD %t, %c
# MIR-NEXT: %s:_(s32) = G_XOR %t, %d
# MIR-LABEL: name: add_reassociate_banks
# MIR: %m:_(s32) = G_AND %v, %k
# MIR-NEXT: [[INNER:%[0-9]+]]:_(s32) = G_ADD %v, %a
# MIR-NEXT: [[OUTER:%[0-9]+]]:_(s32) = G_ADD %b, [[INNER]]
# MIR-NEXT: [[OR:%[0-9]+]]:_(s32) = G_OR %m, [[OUTER]]
# MIR-NEXT: $vgpr0 = COPY [[OR]](s32)
# MIR-LABEL: name: shl_add
# MIR: %s:_(s32) = G_SHL %a, %c3(s32)
# MIR-NEXT: %r:_(s32) = G_ADD %s, %a

---
# (a + 7) + (b + 9): the original is v_add3_u32 and v_add_u32 on GFX9 and
# later (2), the candidate a + b + 16 one v_add3_u32 (16 is inline). GFX8
# has no v_add3_u32: no credit, two adds against three.
name: add_constants
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
    %a:_(s32) = COPY $vgpr0
    %b:_(s32) = COPY $vgpr1
    %c7:_(s32) = G_CONSTANT i32 7
    %c9:_(s32) = G_CONSTANT i32 9
    %x:_(s32) = G_ADD %a, %c7
    %y:_(s32) = G_ADD %b, %c9
    %r:_(s32) = G_ADD %x, %y
    $vgpr0 = COPY %r(s32)
    SI_RETURN implicit $vgpr0
...
---
# The inner add has another user: implementing r as v_add3_u32 keeps t for
# s, so there is no saving and no cover.
name: add_shared_inner
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr2, $vgpr3
    %a:_(s32) = COPY $vgpr0
    %b:_(s32) = COPY $vgpr1
    %c:_(s32) = COPY $vgpr2
    %d:_(s32) = COPY $vgpr3
    %t:_(s32) = G_ADD %a, %b
    %r:_(s32) = G_ADD %t, %c
    %s:_(s32) = G_XOR %t, %d
    $vgpr0 = COPY %r(s32)
    $vgpr1 = COPY %s(s32)
    SI_RETURN implicit $vgpr0, implicit $vgpr1
...
---
# Uniform values: s_add_i32 twice, no VALU fusion; the root must stay
# uniform.
name: add_uniform
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $sgpr0, $sgpr1, $sgpr2
    %a:_(s32) = COPY $sgpr0
    %b:_(s32) = COPY $sgpr1
    %c:_(s32) = COPY $sgpr2
    %t:_(s32) = G_ADD %a, %b
    %r:_(s32) = G_ADD %t, %c
    $sgpr0 = COPY %r(s32)
    SI_RETURN implicit $sgpr0
...
---
# Two SGPR sources: v_add3_u32 needs a v_mov_b32 before GFX10 (constant bus
# limit 1), none from GFX10 on (limit 2).
name: add_two_sgprs
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $sgpr0, $vgpr0, $sgpr1
    %a:_(s32) = COPY $sgpr0
    %b:_(s32) = COPY $vgpr0
    %c:_(s32) = COPY $sgpr1
    %t:_(s32) = G_ADD %a, %b
    %r:_(s32) = G_ADD %t, %c
    $vgpr0 = COPY %r(s32)
    SI_RETURN implicit $vgpr0
...
---
# (a + b) + v with uniform a and b: the uniform inner add is an s_add_i32
# whose result is copied to a VGPR, and the selector does not look through
# the copy, so the original is two instructions. The e-graph also has the
# grouping (v + a) + b (the canonical form of the sum, because v appears
# first), whose inner add is divergent: one v_add3_u32 with two SGPR
# sources from GFX10 on, so the extraction takes it there (with the
# v_and_or_b32 of the mask). Before GFX10 it needs a v_mov_b32 and is no
# gain. Without the patterns both groupings cost the same.
name: add_reassociate_banks
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $sgpr0, $sgpr1, $vgpr0
    %a:_(s32) = COPY $sgpr0
    %b:_(s32) = COPY $sgpr1
    %v:_(s32) = COPY $vgpr0
    %k:_(s32) = G_CONSTANT i32 255
    %m:_(s32) = G_AND %v, %k
    %t:_(s32) = G_ADD %a, %b
    %r:_(s32) = G_ADD %t, %v
    %q:_(s32) = G_OR %m, %r
    $vgpr0 = COPY %q(s32)
    SI_RETURN implicit $vgpr0
...
---
# (a << 3) + a is one v_lshl_add_u32. The e-graph also has a * 9; with a
# multiplication as cheap as one node (-gisel-egraph-mul-cost=1), the node
# count calls that a gain, the pattern cost does not.
name: shl_add
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0
    %a:_(s32) = COPY $vgpr0
    %c3:_(s32) = G_CONSTANT i32 3
    %s:_(s32) = G_SHL %a, %c3
    %r:_(s32) = G_ADD %s, %a
    $vgpr0 = COPY %r(s32)
    SI_RETURN implicit $vgpr0
...
---
# (a + b) << v with uniform a and b: the outer operator of v_add_lshl_u32 is
# cshl_32, whose operands the selector matches through copies, so the
# uniform inner add is folded if the two SGPR sources fit the constant bus
# (GFX10 and later).
name: add_lshl_uniform_inner
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $sgpr0, $sgpr1, $vgpr0
    %a:_(s32) = COPY $sgpr0
    %b:_(s32) = COPY $sgpr1
    %v:_(s32) = COPY $vgpr0
    %t:_(s32) = G_ADD %a, %b
    %r:_(s32) = G_SHL %t, %v
    $vgpr0 = COPY %r(s32)
    SI_RETURN implicit $vgpr0
...
