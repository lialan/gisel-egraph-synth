# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgcn-amd-amdhsa -run-pass=gisel-egraph-combiner -gisel-egraph-mode=rewrite %s -o - | FileCheck %s --check-prefixes=CHECK,LINEAR
# RUN: llc -mtriple=amdgcn-amd-amdhsa -run-pass=gisel-egraph-combiner -gisel-egraph-mode=rewrite -gisel-egraph-features=none %s -o - | FileCheck %s --check-prefixes=CHECK,NONE

# Rewrite mode of the experimental e-graph combiner with the linear view
# (default features) and without it (-gisel-egraph-features=none). The
# inputs are COPYs of argument registers, so they may be undef or poison: a
# rewrite that drops a read of an input is only a refinement.

---
# 5a + 3b + 7c - (a << 2) - a - (b + b + b) - ((c << 3) - c) + d is d: every
# coefficient of a, b and c is 0. The linear view relates the root to d in
# the first iteration. The table rules do not finish within the default
# iteration limit and leave (a - a) + d.
name: cancel_three
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr2, $vgpr3
    ; LINEAR-LABEL: name: cancel_three
    ; LINEAR: liveins: $vgpr0, $vgpr1, $vgpr2, $vgpr3
    ; LINEAR-NEXT: {{  $}}
    ; LINEAR-NEXT: %a:_(s32) = COPY $vgpr0
    ; LINEAR-NEXT: %b:_(s32) = COPY $vgpr1
    ; LINEAR-NEXT: %c:_(s32) = COPY $vgpr2
    ; LINEAR-NEXT: %d:_(s32) = COPY $vgpr3
    ; LINEAR-NEXT: $vgpr0 = COPY %d(s32)
    ; LINEAR-NEXT: SI_RETURN implicit $vgpr0
    ;
    ; NONE-LABEL: name: cancel_three
    ; NONE: liveins: $vgpr0, $vgpr1, $vgpr2, $vgpr3
    ; NONE-NEXT: {{  $}}
    ; NONE-NEXT: %a:_(s32) = COPY $vgpr0
    ; NONE-NEXT: %b:_(s32) = COPY $vgpr1
    ; NONE-NEXT: %c:_(s32) = COPY $vgpr2
    ; NONE-NEXT: %d:_(s32) = COPY $vgpr3
    ; NONE-NEXT: [[SUB:%[0-9]+]]:_(s32) = G_SUB %a, %a
    ; NONE-NEXT: [[ADD:%[0-9]+]]:_(s32) = G_ADD [[SUB]], %d
    ; NONE-NEXT: $vgpr0 = COPY [[ADD]](s32)
    ; NONE-NEXT: SI_RETURN implicit $vgpr0
    %a:_(s32) = COPY $vgpr0
    %b:_(s32) = COPY $vgpr1
    %c:_(s32) = COPY $vgpr2
    %d:_(s32) = COPY $vgpr3
    %k5:_(s32) = G_CONSTANT i32 5
    %k3:_(s32) = G_CONSTANT i32 3
    %k7:_(s32) = G_CONSTANT i32 7
    %k2:_(s32) = G_CONSTANT i32 2
    %a5:_(s32) = G_MUL %a, %k5
    %b3:_(s32) = G_MUL %b, %k3
    %c7:_(s32) = G_MUL %c, %k7
    %s1:_(s32) = G_ADD %a5, %b3
    %s2:_(s32) = G_ADD %s1, %c7
    %a4:_(s32) = G_SHL %a, %k2
    %t1:_(s32) = G_SUB %s2, %a4
    %t2:_(s32) = G_SUB %t1, %a
    %bb:_(s32) = G_ADD %b, %b
    %bbb:_(s32) = G_ADD %bb, %b
    %t3:_(s32) = G_SUB %t2, %bbb
    %c8:_(s32) = G_SHL %c, %k3
    %c8m:_(s32) = G_SUB %c8, %c
    %t4:_(s32) = G_SUB %t3, %c8m
    %r:_(s32) = G_ADD %t4, %d
    $vgpr0 = COPY %r
    SI_RETURN implicit $vgpr0
...
---
# 3a + 2b - (a + a + a) is 2b. Both find b << 1; with the linear view the
# graph saturates (9 iterations), without it the iteration limit stops it.
name: cancel_mul_sum
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
    ; CHECK-LABEL: name: cancel_mul_sum
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %a:_(s32) = COPY $vgpr0
    ; CHECK-NEXT: %b:_(s32) = COPY $vgpr1
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 1
    ; CHECK-NEXT: [[SHL:%[0-9]+]]:_(s32) = G_SHL %b, [[C]](s32)
    ; CHECK-NEXT: $vgpr0 = COPY [[SHL]](s32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    %a:_(s32) = COPY $vgpr0
    %b:_(s32) = COPY $vgpr1
    %c3:_(s32) = G_CONSTANT i32 3
    %c2:_(s32) = G_CONSTANT i32 2
    %a3:_(s32) = G_MUL %a, %c3
    %b2:_(s32) = G_MUL %b, %c2
    %s:_(s32) = G_ADD %a3, %b2
    %aa:_(s32) = G_ADD %a, %a
    %aaa:_(s32) = G_ADD %aa, %a
    %r:_(s32) = G_SUB %s, %aaa
    $vgpr0 = COPY %r
    SI_RETURN implicit $vgpr0
...
---
# ((a << 3) + a) - (b + b) + 7 has the form 9a - 2b + 7, but its canonical
# implementation (a * 9 - (b << 1)) + 7 is not cheaper: the original shift
# and add are kept (no G_MUL is introduced).
name: coefficients_not_cheaper
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
    ; CHECK-LABEL: name: coefficients_not_cheaper
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %a:_(s32) = COPY $vgpr0
    ; CHECK-NEXT: %b:_(s32) = COPY $vgpr1
    ; CHECK-NEXT: %c3:_(s32) = G_CONSTANT i32 3
    ; CHECK-NEXT: %c7:_(s32) = G_CONSTANT i32 7
    ; CHECK-NEXT: %sh:_(s32) = G_SHL %a, %c3(s32)
    ; CHECK-NEXT: %a9:_(s32) = G_ADD %sh, %a
    ; CHECK-NEXT: %bb:_(s32) = G_ADD %b, %b
    ; CHECK-NEXT: %d:_(s32) = G_SUB %a9, %bb
    ; CHECK-NEXT: %r:_(s32) = G_ADD %d, %c7
    ; CHECK-NEXT: $vgpr0 = COPY %r(s32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    %a:_(s32) = COPY $vgpr0
    %b:_(s32) = COPY $vgpr1
    %c3:_(s32) = G_CONSTANT i32 3
    %c7:_(s32) = G_CONSTANT i32 7
    %sh:_(s32) = G_SHL %a, %c3
    %a9:_(s32) = G_ADD %sh, %a
    %bb:_(s32) = G_ADD %b, %b
    %d:_(s32) = G_SUB %a9, %bb
    %r:_(s32) = G_ADD %d, %c7
    $vgpr0 = COPY %r
    SI_RETURN implicit $vgpr0
...
---
# a * 0x8000 + (a << 15) is 0 in 16 bits (the coefficient 2^16 wraps
# around), so the root is b.
name: wrap_around_s16
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
    ; CHECK-LABEL: name: wrap_around_s16
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(s32) = COPY $vgpr0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(s32) = COPY $vgpr1
    ; CHECK-NEXT: %b:_(s16) = G_TRUNC [[COPY1]](s32)
    ; CHECK-NEXT: [[ANYEXT:%[0-9]+]]:_(s32) = G_ANYEXT %b(s16)
    ; CHECK-NEXT: $vgpr0 = COPY [[ANYEXT]](s32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    %0:_(s32) = COPY $vgpr0
    %1:_(s32) = COPY $vgpr1
    %a:_(s16) = G_TRUNC %0
    %b:_(s16) = G_TRUNC %1
    %k:_(s16) = G_CONSTANT i16 -32768
    %k15:_(s16) = G_CONSTANT i16 15
    %m1:_(s16) = G_MUL %a, %k
    %m2:_(s16) = G_SHL %a, %k15
    %s:_(s16) = G_ADD %m1, %m2
    %r:_(s16) = G_ADD %s, %b
    %e:_(s32) = G_ANYEXT %r
    $vgpr0 = COPY %e
    SI_RETURN implicit $vgpr0
...
