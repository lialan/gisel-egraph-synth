# RUN: llc -mtriple=amdgcn-amd-amdhsa -run-pass=gisel-egraph-combiner -gisel-egraph-report -gisel-egraph-features=all,no-patterns %s -o /dev/null 2>&1 | FileCheck %s
# RUN: llc -mtriple=amdgcn-amd-amdhsa -run-pass=gisel-egraph-combiner -gisel-egraph-report %s -o /dev/null 2>&1 | FileCheck %s --check-prefix=AMDGPU

# Two unmerges of one value into parts of different types are two
# instructions. The DAG cost counts them as two, as the emission builds
# them, so the region has no gain (the default costs, one instruction per
# unmerge).

# CHECK: two_unmerges: {{.*}} cost=4->4 not-profitable
# CHECK: one_unmerge: {{.*}} cost=2->2 not-profitable

# The AMDGPU costs take an unmerge into 32-bit parts as subregisters, no
# instruction.
# AMDGPU: one_unmerge: {{.*}} cost=1->1 not-profitable

---
name: two_unmerges
legalized: false
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0_vgpr1
    %a:_(s64) = COPY $vgpr0_vgpr1
    %p0:_(s32), %p1:_(s32) = G_UNMERGE_VALUES %a(s64)
    %q0:_(s16), %q1:_(s16), %q2:_(s16), %q3:_(s16) = G_UNMERGE_VALUES %a(s64)
    %z:_(s32) = G_ZEXT %q3(s16)
    %r:_(s32) = G_XOR %p0, %z
    $vgpr0 = COPY %r(s32)
    SI_RETURN implicit $vgpr0
...
---
name: one_unmerge
legalized: false
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0_vgpr1
    %a:_(s64) = COPY $vgpr0_vgpr1
    %p0:_(s32), %p1:_(s32) = G_UNMERGE_VALUES %a(s64)
    %r:_(s32) = G_XOR %p1, %p0
    $vgpr0 = COPY %r(s32)
    SI_RETURN implicit $vgpr0
...
