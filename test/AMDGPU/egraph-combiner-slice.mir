# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgcn-amd-amdhsa -run-pass=gisel-egraph-combiner -gisel-egraph-mode=rewrite -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -mtriple=amdgcn-amd-amdhsa -run-pass=gisel-egraph-combiner -gisel-egraph-mode=rewrite -gisel-egraph-features=none -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=NONE

# The bit-slice view of the e-graph combiner (docs/TargetAwareViews.md): a
# composition of shifts, masks, truncations, extensions and concatenations
# that selects one field of a value is replaced by the direct form of the
# field. With -gisel-egraph-features=none (the engine without the views)
# no field is found: the regions do not change, except that the table rules
# turn the extensions of truncations of field_of_concatenation into masks.
#
# The stock AMDGPU pipeline forms a G_UBFX from one shift and one mask
# (form_bitfield_extract), but not from a composition: for
# nested_shift_mask it selects two v_bfe_u32, the view one.

---
# ((x >> 4) & 0xff) >> 2 & 0xf is x[6 +: 4].
name: nested_shift_mask
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0
    ; CHECK-LABEL: name: nested_shift_mask
    ; CHECK: liveins: $vgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(s32) = COPY $vgpr0
    ; CHECK-NEXT: %c4:_(s32) = G_CONSTANT i32 4
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 6
    ; CHECK-NEXT: [[UBFX:%[0-9]+]]:_(s32) = G_UBFX %x, [[C]](s32), %c4
    ; CHECK-NEXT: $vgpr0 = COPY [[UBFX]](s32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    ;
    ; NONE-LABEL: name: nested_shift_mask
    ; NONE: liveins: $vgpr0
    ; NONE-NEXT: {{  $}}
    ; NONE-NEXT: %x:_(s32) = COPY $vgpr0
    ; NONE-NEXT: %c4:_(s32) = G_CONSTANT i32 4
    ; NONE-NEXT: %c2:_(s32) = G_CONSTANT i32 2
    ; NONE-NEXT: %c255:_(s32) = G_CONSTANT i32 255
    ; NONE-NEXT: %c15:_(s32) = G_CONSTANT i32 15
    ; NONE-NEXT: %a:_(s32) = G_LSHR %x, %c4(s32)
    ; NONE-NEXT: %b:_(s32) = G_AND %a, %c255
    ; NONE-NEXT: %c:_(s32) = G_LSHR %b, %c2(s32)
    ; NONE-NEXT: %r:_(s32) = G_AND %c, %c15
    ; NONE-NEXT: $vgpr0 = COPY %r(s32)
    ; NONE-NEXT: SI_RETURN implicit $vgpr0
    %x:_(s32) = COPY $vgpr0
    %c4:_(s32) = G_CONSTANT i32 4
    %c2:_(s32) = G_CONSTANT i32 2
    %c255:_(s32) = G_CONSTANT i32 255
    %c15:_(s32) = G_CONSTANT i32 15
    %a:_(s32) = G_LSHR %x, %c4
    %b:_(s32) = G_AND %a, %c255
    %c:_(s32) = G_LSHR %b, %c2
    %r:_(s32) = G_AND %c, %c15
    $vgpr0 = COPY %r
    SI_RETURN implicit $vgpr0
...
---
# The same after the legalizer, where every new instruction must be legal.
name: nested_shift_mask_legalized
legalized: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0
    ; CHECK-LABEL: name: nested_shift_mask_legalized
    ; CHECK: liveins: $vgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(s32) = COPY $vgpr0
    ; CHECK-NEXT: %c4:_(s32) = G_CONSTANT i32 4
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 6
    ; CHECK-NEXT: [[UBFX:%[0-9]+]]:_(s32) = G_UBFX %x, [[C]](s32), %c4
    ; CHECK-NEXT: $vgpr0 = COPY [[UBFX]](s32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    ;
    ; NONE-LABEL: name: nested_shift_mask_legalized
    ; NONE: liveins: $vgpr0
    ; NONE-NEXT: {{  $}}
    ; NONE-NEXT: %x:_(s32) = COPY $vgpr0
    ; NONE-NEXT: %c4:_(s32) = G_CONSTANT i32 4
    ; NONE-NEXT: %c2:_(s32) = G_CONSTANT i32 2
    ; NONE-NEXT: %c255:_(s32) = G_CONSTANT i32 255
    ; NONE-NEXT: %c15:_(s32) = G_CONSTANT i32 15
    ; NONE-NEXT: %a:_(s32) = G_LSHR %x, %c4(s32)
    ; NONE-NEXT: %b:_(s32) = G_AND %a, %c255
    ; NONE-NEXT: %c:_(s32) = G_LSHR %b, %c2(s32)
    ; NONE-NEXT: %r:_(s32) = G_AND %c, %c15
    ; NONE-NEXT: $vgpr0 = COPY %r(s32)
    ; NONE-NEXT: SI_RETURN implicit $vgpr0
    %x:_(s32) = COPY $vgpr0
    %c4:_(s32) = G_CONSTANT i32 4
    %c2:_(s32) = G_CONSTANT i32 2
    %c255:_(s32) = G_CONSTANT i32 255
    %c15:_(s32) = G_CONSTANT i32 15
    %a:_(s32) = G_LSHR %x, %c4
    %b:_(s32) = G_AND %a, %c255
    %c:_(s32) = G_LSHR %b, %c2
    %r:_(s32) = G_AND %c, %c15
    $vgpr0 = COPY %r
    SI_RETURN implicit $vgpr0
...
---
# ((x >>a 4) << 16) >>a 20 is the sign extension of x[8 +: 12].
name: signed_field_of_shifts
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0
    ; CHECK-LABEL: name: signed_field_of_shifts
    ; CHECK: liveins: $vgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(s32) = COPY $vgpr0
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 8
    ; CHECK-NEXT: [[C1:%[0-9]+]]:_(s32) = G_CONSTANT i32 12
    ; CHECK-NEXT: [[SBFX:%[0-9]+]]:_(s32) = G_SBFX %x, [[C]](s32), [[C1]]
    ; CHECK-NEXT: $vgpr0 = COPY [[SBFX]](s32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    ;
    ; NONE-LABEL: name: signed_field_of_shifts
    ; NONE: liveins: $vgpr0
    ; NONE-NEXT: {{  $}}
    ; NONE-NEXT: %x:_(s32) = COPY $vgpr0
    ; NONE-NEXT: %c4:_(s32) = G_CONSTANT i32 4
    ; NONE-NEXT: %c16:_(s32) = G_CONSTANT i32 16
    ; NONE-NEXT: %c20:_(s32) = G_CONSTANT i32 20
    ; NONE-NEXT: %a:_(s32) = G_ASHR %x, %c4(s32)
    ; NONE-NEXT: %b:_(s32) = G_SHL %a, %c16(s32)
    ; NONE-NEXT: %r:_(s32) = G_ASHR %b, %c20(s32)
    ; NONE-NEXT: $vgpr0 = COPY %r(s32)
    ; NONE-NEXT: SI_RETURN implicit $vgpr0
    %x:_(s32) = COPY $vgpr0
    %c4:_(s32) = G_CONSTANT i32 4
    %c16:_(s32) = G_CONSTANT i32 16
    %c20:_(s32) = G_CONSTANT i32 20
    %a:_(s32) = G_ASHR %x, %c4
    %b:_(s32) = G_SHL %a, %c16
    %r:_(s32) = G_ASHR %b, %c20
    $vgpr0 = COPY %r
    SI_RETURN implicit $vgpr0
...
---
# trunc((x >> 20) & 0xffff) >> 4 & 0xff of an s64 x is x[24 +: 8], which is
# inside the low half: trunc(x) >> 24, without the 64-bit shift.
name: field_of_wide_value
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0_vgpr1
    ; CHECK-LABEL: name: field_of_wide_value
    ; CHECK: liveins: $vgpr0_vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(s64) = COPY $vgpr0_vgpr1
    ; CHECK-NEXT: [[TRUNC:%[0-9]+]]:_(s32) = G_TRUNC %x(s64)
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 24
    ; CHECK-NEXT: [[LSHR:%[0-9]+]]:_(s32) = G_LSHR [[TRUNC]], [[C]](s32)
    ; CHECK-NEXT: $vgpr0 = COPY [[LSHR]](s32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    ;
    ; NONE-LABEL: name: field_of_wide_value
    ; NONE: liveins: $vgpr0_vgpr1
    ; NONE-NEXT: {{  $}}
    ; NONE-NEXT: %x:_(s64) = COPY $vgpr0_vgpr1
    ; NONE-NEXT: %c20:_(s64) = G_CONSTANT i64 20
    ; NONE-NEXT: %cffff:_(s64) = G_CONSTANT i64 65535
    ; NONE-NEXT: %c4:_(s32) = G_CONSTANT i32 4
    ; NONE-NEXT: %c255:_(s32) = G_CONSTANT i32 255
    ; NONE-NEXT: %a:_(s64) = G_LSHR %x, %c20(s64)
    ; NONE-NEXT: %b:_(s64) = G_AND %a, %cffff
    ; NONE-NEXT: %t:_(s32) = G_TRUNC %b(s64)
    ; NONE-NEXT: %c:_(s32) = G_LSHR %t, %c4(s32)
    ; NONE-NEXT: %r:_(s32) = G_AND %c, %c255
    ; NONE-NEXT: $vgpr0 = COPY %r(s32)
    ; NONE-NEXT: SI_RETURN implicit $vgpr0
    %x:_(s64) = COPY $vgpr0_vgpr1
    %c20:_(s64) = G_CONSTANT i64 20
    %cffff:_(s64) = G_CONSTANT i64 65535
    %c4:_(s32) = G_CONSTANT i32 4
    %c255:_(s32) = G_CONSTANT i32 255
    %a:_(s64) = G_LSHR %x, %c20
    %b:_(s64) = G_AND %a, %cffff
    %t:_(s32) = G_TRUNC %b
    %c:_(s32) = G_LSHR %t, %c4
    %r:_(s32) = G_AND %c, %c255
    $vgpr0 = COPY %r
    SI_RETURN implicit $vgpr0
...
---
# The concatenation of the low halves of two registers, as an OR of
# extensions; bits [20, 28) of it are bits [4, 12) of the second register.
# The OR also reads the first half, which the field does not depend on: the
# new form only refines the region (it is not poison when the first half
# is), which is a valid replacement.
name: field_of_concatenation
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
    ; CHECK-LABEL: name: field_of_concatenation
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(s32) = COPY $vgpr0
    ; CHECK-NEXT: %y:_(s32) = COPY $vgpr1
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 4
    ; CHECK-NEXT: [[C1:%[0-9]+]]:_(s32) = G_CONSTANT i32 8
    ; CHECK-NEXT: [[UBFX:%[0-9]+]]:_(s32) = G_UBFX %y, [[C]](s32), [[C1]]
    ; CHECK-NEXT: $vgpr0 = COPY [[UBFX]](s32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    ;
    ; NONE-LABEL: name: field_of_concatenation
    ; NONE: liveins: $vgpr0, $vgpr1
    ; NONE-NEXT: {{  $}}
    ; NONE-NEXT: %x:_(s32) = COPY $vgpr0
    ; NONE-NEXT: %y:_(s32) = COPY $vgpr1
    ; NONE-NEXT: %c16:_(s32) = G_CONSTANT i32 16
    ; NONE-NEXT: %c20:_(s32) = G_CONSTANT i32 20
    ; NONE-NEXT: %c255:_(s32) = G_CONSTANT i32 255
    ; NONE-NEXT: [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 65535
    ; NONE-NEXT: [[AND:%[0-9]+]]:_(s32) = G_AND %x, [[C]]
    ; NONE-NEXT: [[AND1:%[0-9]+]]:_(s32) = G_AND %y, [[C]]
    ; NONE-NEXT: [[SHL:%[0-9]+]]:_(s32) = G_SHL [[AND1]], %c16(s32)
    ; NONE-NEXT: [[OR:%[0-9]+]]:_(s32) = G_OR [[AND]], [[SHL]]
    ; NONE-NEXT: [[LSHR:%[0-9]+]]:_(s32) = G_LSHR [[OR]], %c20(s32)
    ; NONE-NEXT: [[AND2:%[0-9]+]]:_(s32) = G_AND [[LSHR]], %c255
    ; NONE-NEXT: $vgpr0 = COPY [[AND2]](s32)
    ; NONE-NEXT: SI_RETURN implicit $vgpr0
    %x:_(s32) = COPY $vgpr0
    %y:_(s32) = COPY $vgpr1
    %c16:_(s32) = G_CONSTANT i32 16
    %c20:_(s32) = G_CONSTANT i32 20
    %c255:_(s32) = G_CONSTANT i32 255
    %lo:_(s16) = G_TRUNC %x
    %hi:_(s16) = G_TRUNC %y
    %zlo:_(s32) = G_ZEXT %lo
    %zhi:_(s32) = G_ZEXT %hi
    %shi:_(s32) = G_SHL %zhi, %c16
    %v:_(s32) = G_OR %zlo, %shi
    %f:_(s32) = G_LSHR %v, %c20
    %r:_(s32) = G_AND %f, %c255
    $vgpr0 = COPY %r
    SI_RETURN implicit $vgpr0
...
---
# One shift and one mask: a G_UBFX here; the stock post-legalizer combiner
# forms the same instruction later.
name: shift_mask
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0
    ; CHECK-LABEL: name: shift_mask
    ; CHECK: liveins: $vgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(s32) = COPY $vgpr0
    ; CHECK-NEXT: %c8:_(s32) = G_CONSTANT i32 8
    ; CHECK-NEXT: [[UBFX:%[0-9]+]]:_(s32) = G_UBFX %x, %c8(s32), %c8
    ; CHECK-NEXT: $vgpr0 = COPY [[UBFX]](s32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    ;
    ; NONE-LABEL: name: shift_mask
    ; NONE: liveins: $vgpr0
    ; NONE-NEXT: {{  $}}
    ; NONE-NEXT: %x:_(s32) = COPY $vgpr0
    ; NONE-NEXT: %c8:_(s32) = G_CONSTANT i32 8
    ; NONE-NEXT: %c255:_(s32) = G_CONSTANT i32 255
    ; NONE-NEXT: %a:_(s32) = G_LSHR %x, %c8(s32)
    ; NONE-NEXT: %r:_(s32) = G_AND %a, %c255
    ; NONE-NEXT: $vgpr0 = COPY %r(s32)
    ; NONE-NEXT: SI_RETURN implicit $vgpr0
    %x:_(s32) = COPY $vgpr0
    %c8:_(s32) = G_CONSTANT i32 8
    %c255:_(s32) = G_CONSTANT i32 255
    %a:_(s32) = G_LSHR %x, %c8
    %r:_(s32) = G_AND %a, %c255
    $vgpr0 = COPY %r
    SI_RETURN implicit $vgpr0
...
---
# A mask with two fields is not a slice: the region does not change.
name: two_fields
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0
    ; CHECK-LABEL: name: two_fields
    ; CHECK: liveins: $vgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(s32) = COPY $vgpr0
    ; CHECK-NEXT: %c4:_(s32) = G_CONSTANT i32 4
    ; CHECK-NEXT: %cmask:_(s32) = G_CONSTANT i32 3855
    ; CHECK-NEXT: %a:_(s32) = G_LSHR %x, %c4(s32)
    ; CHECK-NEXT: %r:_(s32) = G_AND %a, %cmask
    ; CHECK-NEXT: $vgpr0 = COPY %r(s32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    ;
    ; NONE-LABEL: name: two_fields
    ; NONE: liveins: $vgpr0
    ; NONE-NEXT: {{  $}}
    ; NONE-NEXT: %x:_(s32) = COPY $vgpr0
    ; NONE-NEXT: %c4:_(s32) = G_CONSTANT i32 4
    ; NONE-NEXT: %cmask:_(s32) = G_CONSTANT i32 3855
    ; NONE-NEXT: %a:_(s32) = G_LSHR %x, %c4(s32)
    ; NONE-NEXT: %r:_(s32) = G_AND %a, %cmask
    ; NONE-NEXT: $vgpr0 = COPY %r(s32)
    ; NONE-NEXT: SI_RETURN implicit $vgpr0
    %x:_(s32) = COPY $vgpr0
    %c4:_(s32) = G_CONSTANT i32 4
    %cmask:_(s32) = G_CONSTANT i32 3855
    %a:_(s32) = G_LSHR %x, %c4
    %r:_(s32) = G_AND %a, %cmask
    $vgpr0 = COPY %r
    SI_RETURN implicit $vgpr0
...
