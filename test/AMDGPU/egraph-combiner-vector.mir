# RUN: llc -mtriple=amdgcn-amd-amdhsa -run-pass=gisel-egraph-combiner -gisel-egraph-mode=rewrite -verify-machineinstrs -o - %s | FileCheck %s
# RUN: rm -f %t.jsonl
# RUN: llc -mtriple=amdgcn-amd-amdhsa -run-pass=gisel-egraph-combiner -gisel-egraph-export=%t.jsonl -o /dev/null %s
# RUN: FileCheck %s --check-prefix=EXPORT --input-file=%t.jsonl

# Regions with fixed vectors: the lanes of a G_BUILD_VECTOR, of a
# G_SHUFFLE_VECTOR and of a lane-wise operation (OpShape::Vector and the lane
# rules of GIEGraphLanes.cpp).

# A build of the lanes of a vector in their order is the vector.
# CHECK-LABEL: name: build_of_extracts
# CHECK: %0:_(<2 x s16>) = COPY $vgpr0
# CHECK-NOT: G_BUILD_VECTOR
# CHECK: $vgpr0 = COPY %0(<2 x s16>)

# The index of an extraction through a shuffle is remapped: lane 0 of the
# shuffle is lane 3 of the concatenation, lane 1 of the second operand.
# CHECK-LABEL: name: extract_through_shuffle
# CHECK-NOT: G_SHUFFLE_VECTOR
# CHECK: [[IDX:%[0-9]+]]:_(i32) = G_CONSTANT i32 1
# CHECK: [[E:%[0-9]+]]:_(s32) = G_EXTRACT_VECTOR_ELT %1(<2 x s32>), [[IDX]](i32)
# CHECK: $vgpr0 = COPY [[E]](s32)

# Overflow of the low lane does not carry into the high lane:
# <0xffff, 2> + <1, 3> is <0, 5>, not the packed integer sum <0, 6>.
# CHECK-LABEL: name: constant_lanes
# CHECK-DAG: [[ZERO:%[0-9]+]]:_(s16) = G_CONSTANT i16 0
# CHECK-DAG: [[FIVE:%[0-9]+]]:_(s16) = G_CONSTANT i16 5
# CHECK: [[V:%[0-9]+]]:_(<2 x s16>) = G_BUILD_VECTOR [[ZERO]](s16), [[FIVE]](s16)
# CHECK-NOT: G_ADD
# CHECK: $vgpr0 = COPY [[V]](<2 x s16>)

# Two shuffles of the same operands with other masks are two values.
# CHECK-LABEL: name: two_masks
# CHECK: G_SHUFFLE_VECTOR %0(<2 x s16>), %1, shufflemask(1, 0)
# CHECK: G_SHUFFLE_VECTOR %0(<2 x s16>), %1, shufflemask(0, 3)
# CHECK: G_XOR

# Table rules create a splat zero for y ^ y and match it in x ^ zero.
# The final value is the original opaque vector, without scalarization.
# With possibly undef or poison y, this is a directed refinement.
# CHECK-LABEL: name: xor_twice
# CHECK: %0:_(<2 x s16>) = COPY $vgpr0
# CHECK-NOT: G_XOR
# CHECK: $vgpr0 = COPY %0(<2 x s16>)

# Literal identities match all lanes, using the element width for -1.
# CHECK-LABEL: name: splat_identities
# CHECK: %0:_(<2 x s16>) = COPY $vgpr0
# CHECK-NOT: G_XOR
# CHECK-NOT: G_AND
# CHECK: $vgpr0 = COPY %0(<2 x s16>)

# %0 may be undef, so x ^ x only refines to a zero splat, and
# (x ^ x) + (x ^ x) refines to x ^ x (add-zero through the refinement edge).
# Both refinements cost one instruction; the extractor keeps the first, the
# existing XOR, and drops the add.
# CHECK-LABEL: name: xor_self
# CHECK: %1:_(<2 x s16>) = G_XOR %0, %0
# CHECK-NOT: G_ADD
# CHECK: $vgpr0 = COPY %1(<2 x s16>)

# A zero in only one lane does not match the literal zero.
# CHECK-LABEL: name: nonuniform_zero
# CHECK: %4:_(<2 x s16>) = G_XOR %0, %3
# CHECK: $vgpr0 = COPY %4(<2 x s16>)

# A #constant match and a computed RHS constant retain the vector shape.
# CHECK-LABEL: name: mul_splat_power_of_two
# CHECK: [[THREE:%[0-9]+]]:_(s16) = G_CONSTANT i16 3
# CHECK: [[AMOUNT:%[0-9]+]]:_(<2 x s16>) = G_BUILD_VECTOR [[THREE]](s16), [[THREE]](s16)
# CHECK-NOT: G_MUL
# CHECK: [[SHIFT:%[0-9]+]]:_(<2 x s16>) = G_SHL %0, [[AMOUNT]](<2 x s16>)
# CHECK: $vgpr0 = COPY [[SHIFT]](<2 x s16>)

# The export has the index of a lane ("imm"), the mask of a shuffle ("mask")
# and the names of the lane rules.
# EXPORT: {"version":3,"fn":"build_of_extracts"
# EXPORT-SAME: "type":"<2 x s16>"
# EXPORT-SAME: {"id":1,"op":"G_EXTRACT_VECTOR_ELT","imm":0,
# EXPORT-SAME: "roots":[{"reg":"%5","original":3,"optimized":0}]
# EXPORT-SAME: "vector-build-of-extracts":1
# EXPORT: {"version":3,"fn":"extract_through_shuffle"
# EXPORT-SAME: {"id":2,"op":"G_SHUFFLE_VECTOR","mask":[3,0],
# EXPORT-SAME: "optimized":[{"id":1,"in":1},{"id":3,"op":"G_EXTRACT_VECTOR_ELT","imm":1,"type":"s32","args":[1]}
# EXPORT-SAME: "vector-extract-of-shuffle":1
# EXPORT: {"version":3,"fn":"constant_lanes"
# EXPORT-SAME: "vector-lanewise-of-build":1
# EXPORT-NOT: "fn":"two_masks"
# EXPORT: {"version":3,"fn":"xor_twice"
# EXPORT-SAME: "optimized":[{"id":0,"in":0},
# EXPORT-SAME: "roots":[{"reg":"%3","original":3,"optimized":0}]

---
name: build_of_extracts
body: |
  bb.0:
    liveins: $vgpr0
    %0:_(<2 x s16>) = COPY $vgpr0
    %1:_(s32) = G_CONSTANT i32 0
    %2:_(s32) = G_CONSTANT i32 1
    %3:_(s16) = G_EXTRACT_VECTOR_ELT %0(<2 x s16>), %1(s32)
    %4:_(s16) = G_EXTRACT_VECTOR_ELT %0(<2 x s16>), %2(s32)
    %5:_(<2 x s16>) = G_BUILD_VECTOR %3(s16), %4(s16)
    $vgpr0 = COPY %5(<2 x s16>)
    SI_RETURN implicit $vgpr0
...
---
name: extract_through_shuffle
body: |
  bb.0:
    liveins: $vgpr0_vgpr1, $vgpr2_vgpr3
    %0:_(<2 x s32>) = COPY $vgpr0_vgpr1
    %1:_(<2 x s32>) = COPY $vgpr2_vgpr3
    %2:_(<2 x s32>) = G_SHUFFLE_VECTOR %0(<2 x s32>), %1, shufflemask(3, 0)
    %3:_(s32) = G_CONSTANT i32 0
    %4:_(s32) = G_EXTRACT_VECTOR_ELT %2(<2 x s32>), %3(s32)
    $vgpr0 = COPY %4(s32)
    SI_RETURN implicit $vgpr0
...
---
name: constant_lanes
body: |
  bb.0:
    %0:_(s16) = G_CONSTANT i16 -1
    %1:_(s16) = G_CONSTANT i16 2
    %2:_(s16) = G_CONSTANT i16 1
    %3:_(s16) = G_CONSTANT i16 3
    %4:_(<2 x s16>) = G_BUILD_VECTOR %0(s16), %1(s16)
    %5:_(<2 x s16>) = G_BUILD_VECTOR %2(s16), %3(s16)
    %6:_(<2 x s16>) = G_ADD %4, %5
    $vgpr0 = COPY %6(<2 x s16>)
    SI_RETURN implicit $vgpr0
...
---
name: two_masks
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
    %0:_(<2 x s16>) = COPY $vgpr0
    %1:_(<2 x s16>) = COPY $vgpr1
    %2:_(<2 x s16>) = G_SHUFFLE_VECTOR %0(<2 x s16>), %1, shufflemask(1, 0)
    %3:_(<2 x s16>) = G_SHUFFLE_VECTOR %0(<2 x s16>), %1, shufflemask(0, 3)
    %4:_(<2 x s16>) = G_XOR %2, %3
    $vgpr0 = COPY %4(<2 x s16>)
    SI_RETURN implicit $vgpr0
...
---
name: xor_twice
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
    %0:_(<2 x s16>) = COPY $vgpr0
    %1:_(<2 x s16>) = COPY $vgpr1
    %2:_(<2 x s16>) = G_XOR %0, %1
    %3:_(<2 x s16>) = G_XOR %2, %1
    $vgpr0 = COPY %3(<2 x s16>)
    SI_RETURN implicit $vgpr0
...
---
name: splat_identities
body: |
  bb.0:
    liveins: $vgpr0
    %0:_(<2 x s16>) = COPY $vgpr0
    %1:_(s16) = G_CONSTANT i16 0
    %2:_(s16) = G_CONSTANT i16 -1
    %3:_(<2 x s16>) = G_BUILD_VECTOR %1(s16), %1(s16)
    %4:_(<2 x s16>) = G_BUILD_VECTOR %2(s16), %2(s16)
    %5:_(<2 x s16>) = G_XOR %0, %3
    %6:_(<2 x s16>) = G_AND %5, %4
    $vgpr0 = COPY %6(<2 x s16>)
    SI_RETURN implicit $vgpr0
...
---
name: xor_self
body: |
  bb.0:
    liveins: $vgpr0
    %0:_(<2 x s16>) = COPY $vgpr0
    %1:_(<2 x s16>) = G_XOR %0, %0
    %2:_(<2 x s16>) = G_ADD %1, %1
    $vgpr0 = COPY %2(<2 x s16>)
    SI_RETURN implicit $vgpr0
...
---
name: nonuniform_zero
body: |
  bb.0:
    liveins: $vgpr0
    %0:_(<2 x s16>) = COPY $vgpr0
    %1:_(s16) = G_CONSTANT i16 0
    %2:_(s16) = G_CONSTANT i16 1
    %3:_(<2 x s16>) = G_BUILD_VECTOR %1(s16), %2(s16)
    %4:_(<2 x s16>) = G_XOR %0, %3
    $vgpr0 = COPY %4(<2 x s16>)
    SI_RETURN implicit $vgpr0
...
---
name: mul_splat_power_of_two
body: |
  bb.0:
    liveins: $vgpr0
    %0:_(<2 x s16>) = COPY $vgpr0
    %1:_(s16) = G_CONSTANT i16 8
    %2:_(<2 x s16>) = G_BUILD_VECTOR %1(s16), %1(s16)
    %3:_(<2 x s16>) = G_MUL %0, %2
    $vgpr0 = COPY %3(<2 x s16>)
    SI_RETURN implicit $vgpr0
...
